# Frontend environment variables
# Copy to .env.local for local dev, set in Vercel dashboard for production.

# URL of the backend API (Node/Express server that runs yt-dlp + FFmpeg).
# Leave empty in local dev to use the Next.js rewrite proxy -> http://localhost:3010
# In Vercel, set this to your deployed backend URL, e.g. https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=
